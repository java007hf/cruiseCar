.gradle/
build/
**/build/
.idea/
*.iml
local.properties
sdkconfig
sdkconfig.old
managed_components/

# ---- ml/: keep only uploaded source videos + final downloadable .pt exports;
#      ignore all intermediate training artifacts and transient scratch data ----
# Python environments / caches (always ignore)
ml/**/.venv/
ml/**/.venv*/
ml/**/*.cache
ml/**/__pycache__/

# 1) extractions/  -> extracted frame JPGs + train/val split copies, regenerable.
ml/extractions/**
!ml/extractions/.gitkeep

# 2) datasets/     -> labels/, dataset.yaml, dataset/{images,labels}/{train,val}/ etc, regenerable.
ml/datasets/**
!ml/datasets/.gitkeep

# 3) weights/      -> base pretrained checkpoints (yolo11n.pt, yolo26n.pt, yolov8s-worldv2.pt, …),
#                     re-downloadable. Keep skeleton .gitkeep only.
ml/weights/**
!ml/weights/.gitkeep
# base weights may also be dropped directly under ml/ by accident (e.g. ultralytics default
# save path), also ignore those to avoid polluting history.
ml/yolo*.pt
ml/*.pt
# (keeps only `ml/outputs/*.pt` via the outputs/ whitelist below — and uploads/*.mov as source videos)

# 4) _tmp/         -> transient scratch pad, always ignore.
ml/_tmp/**

# 5) uploads/      -> KEEP the raw source videos the user uploaded (no ignore rule here,
#                     so everything in uploads/ is tracked). Keep .gitkeep as skeleton only
#                     if the folder is otherwise empty.
# (no rule = files under uploads/ are tracked)

# 6) outputs/      -> ignore ultralytics run logs ({run_id}/ subdirs, events, optimizers, …);
#                     only keep top-level final .pt exports produced by the web UI as the
#                     downloadable artifact (e.g. beibingyang_can_20260804_232133.pt) and the
#                     skeleton .gitkeep.
ml/outputs/**
!ml/outputs/.gitkeep
!ml/outputs/*.pt

# ---- Root-level training leftovers from earlier iterations (fully gitignore, but only at repo root) ----
/runs/
/weights/
/yolo*.pt
/yolov8s-worldv2.pt

# Numpy calibration / intermediate tensors (onnx2tf INT8 calibration samples, inference caches, …).
# Binary blobs regenerated from Python code; keeping them would bloat history with opaque float32 arrays.
ml/**/*.npy
# Also catch onnx2tf calibration dumps accidentally dropped at repo root (it checks cwd first).
/*.npy

# Backup sidecars of broken/old model files (kept only locally as emergency rollback;
# real rollback path is `git checkout` or `git show <sha>:path` against the history).
*.backup

# Android assets
android-app/app/src/main/assets/target_object.jpg
